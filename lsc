#!/usr/bin/env python3
import os
import sys
import stat
import pwd
import grp
import time
import datetime
import ctypes
import plistlib
import zipfile
import shlex
import argparse
import locale

# Initialize locale for correct date representation (e.g. Swedish month names)
try:
    locale.setlocale(locale.LC_ALL, '')
except Exception:
    pass

# Load libc to access macOS extended attributes
libc = None
if sys.platform == 'darwin':
    try:
        libc = ctypes.CDLL(None)
        
        # ssize_t getxattr(const char *path, const char *name, void *value, size_t size, u_int32_t position, int options);
        libc.getxattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint32, ctypes.c_int]
        libc.getxattr.restype = ctypes.c_ssize_t
        
        # ssize_t listxattr(const char *path, char *namebuf, size_t size, int options);
        libc.listxattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_size_t, ctypes.c_int]
        libc.listxattr.restype = ctypes.c_ssize_t

        # int setxattr(const char *path, const char *name, const void *value, size_t size, u_int32_t position, int options);
        libc.setxattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint32, ctypes.c_int]
        libc.setxattr.restype = ctypes.c_int

        # int removexattr(const char *path, const char *name, int options);
        libc.removexattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int]
        libc.removexattr.restype = ctypes.c_int
    except Exception:
        libc = None

def parse_env_colors():
    # Start with our default fallback colors
    colors = {
        'dir': '\033[1;36m',
        'link': '\033[35m',
        'exec': '\033[1;32m',
        'socket': '\033[36m',
        'fifo': '\033[33m',
        'device': '\033[1;33m',
        'reset': '\033[0m',
        'comment': '\033[37m'  # Light gray for comments
    }

    # 1. Try to parse GNU LS_COLORS
    gnu_colors = os.environ.get('LS_COLORS')
    if gnu_colors:
        key_mapping = {
            'di': 'dir',
            'ln': 'link',
            'ex': 'exec',
            'so': 'socket',
            'pi': 'fifo',
            'bd': 'device',
            'cd': 'device'
        }
        for item in gnu_colors.split(':'):
            if '=' in item:
                k, v = item.split('=', 1)
                if k in key_mapping:
                    colors[key_mapping[k]] = f"\033[{v}m"
        return colors

    # 2. Try to parse BSD LSCOLORS (common on macOS)
    bsd_colors = os.environ.get('LSCOLORS')
    if bsd_colors and len(bsd_colors) >= 22:
        bsd_fg = {
            'a': '30', 'b': '31', 'c': '32', 'd': '33', 'e': '34', 'f': '35', 'g': '36', 'h': '37',
            'A': '1;30', 'B': '1;31', 'C': '1;32', 'D': '1;33', 'E': '1;34', 'F': '1;35', 'G': '1;36', 'H': '1;37'
        }
        bsd_bg = {
            'a': '40', 'b': '41', 'c': '42', 'd': '43', 'e': '44', 'f': '45', 'g': '46', 'h': '47'
        }
        
        index_mapping = {
            0: 'dir',
            1: 'link',
            2: 'socket',
            3: 'fifo',
            4: 'exec',
            5: 'device',
            6: 'device'
        }
        
        for i, key in index_mapping.items():
            fg_char = bsd_colors[2*i]
            bg_char = bsd_colors[2*i + 1]
            
            codes = []
            if fg_char in bsd_fg:
                codes.append(bsd_fg[fg_char])
            if bg_char in bsd_bg:
                codes.append(bsd_bg[bg_char])
            
            if codes:
                colors[key] = f"\033[{';'.join(codes)}m"
        return colors

    return colors

# ANSI colors for styling, parsed from environment or falling back to defaults
COLORS = parse_env_colors()

def colorize(text, color_name, use_color):
    if not use_color:
        return text
    return f"{COLORS.get(color_name, '')}{text}{COLORS['reset']}"

# Cache for descript.ion contents to avoid multiple parses of the same file
_description_cache = {}

def get_descript_ion_comment(filepath):
    dirpath = os.path.dirname(os.path.abspath(filepath))
    filename = os.path.basename(filepath)
    
    if dirpath not in _description_cache:
        descriptions = {}
        ion_path = os.path.join(dirpath, "descript.ion")
        if os.path.exists(ion_path):
            try:
                with open(ion_path, "r", encoding="utf-8", errors="ignore") as f:
                    for line in f:
                        line = line.strip()
                        if not line or line.startswith("#"):
                            continue
                        try:
                            parts = shlex.split(line)
                        except ValueError:
                            parts = line.split(maxsplit=1)
                        
                        if len(parts) >= 2:
                            fname = parts[0]
                            desc = " ".join(parts[1:])
                            # Strip quotes
                            fname = fname.strip('"').strip("'")
                            descriptions[fname] = desc
            except Exception:
                pass
        _description_cache[dirpath] = descriptions
        
    return _description_cache[dirpath].get(filename, None)

def clean_comment(comment):
    if not comment:
        return ""
    cleaned = []
    for char in comment:
        if char in ('\n', '\r', '\t'):
            cleaned.append(' ')
        elif char.isprintable():
            cleaned.append(char)
    return " ".join("".join(cleaned).split())

def get_finder_comment(path):
    if not libc:
        return None
    name = 'com.apple.metadata:kMDItemFinderComment'
    path_bytes = path.encode('utf-8')
    name_bytes = name.encode('utf-8')
    
    try:
        size = libc.getxattr(path_bytes, name_bytes, None, 0, 0, 0)
        if size <= 0:
            return None
        buf = ctypes.create_string_buffer(size)
        res = libc.getxattr(path_bytes, name_bytes, buf, size, 0, 0)
        if res > 0:
            data = buf.raw[:res]
            if data.startswith(b'bplist'):
                try:
                    comment = plistlib.loads(data)
                except Exception:
                    return None
            else:
                try:
                    comment = data.decode('utf-8', errors='ignore')
                except Exception:
                    return None
            
            if isinstance(comment, str):
                return comment.strip()
            elif isinstance(comment, (list, tuple)) and len(comment) > 0:
                first = comment[0]
                if isinstance(first, str):
                    return first.strip()
    except Exception:
        pass
    return None

def get_zip_diz_comment(filepath):
    if not filepath.lower().endswith('.zip'):
        return None
    if not zipfile.is_zipfile(filepath):
        return None
    try:
        with zipfile.ZipFile(filepath) as z:
            for name in z.namelist():
                if name.lower() == "file_id.diz":
                    with z.open(name) as f:
                        content = f.read()
                        try:
                            text = content.decode('cp866', errors='replace')
                        except Exception:
                            text = content.decode('utf-8', errors='replace')
                        
                        lines = [line.strip() for line in text.splitlines() if line.strip()]
                        if lines:
                            first_line = lines[0]
                            if len(lines) > 1:
                                first_line += "..."
                            return first_line
    except Exception:
        pass
    return None

def has_xattrs(path):
    if not libc:
        return False
    try:
        path_bytes = path.encode('utf-8')
        size = libc.listxattr(path_bytes, None, 0, 0)
        return size > 0
    except Exception:
        return False

def format_mtime(mtime, now):
    dt = datetime.datetime.fromtimestamp(mtime)
    six_months_sec = 182 * 24 * 3600
    show_year = abs(now - mtime) > six_months_sec
    
    lang = locale.getlocale(locale.LC_TIME)[0] or ""
    is_sv = lang.startswith("sv") or "swedish" in lang.lower()
    
    month = dt.strftime("%b")
    day = f"{dt.day:>2}"
    
    if is_sv:
        if show_year:
            return f"{day} {month:<4}  {dt.year}"
        else:
            return f"{day} {month:<4} {dt.strftime('%H:%M')}"
    else:
        if show_year:
            return f"{month} {day}  {dt.year}"
        else:
            return f"{month} {day} {dt.strftime('%H:%M')}"

def format_size(size, human=False):
    if not human:
        return str(size)
    if size < 1024:
        return f"{size}B"
    for unit in ['K', 'M', 'G', 'T', 'P', 'E']:
        size /= 1024.0
        if size < 10.0:
            return f"{size:.1f}{unit}"
        elif size < 1024.0:
            return f"{int(round(size))}{unit}"
    return f"{int(round(size))}Y"

def get_file_info(filepath, filename, args, use_color, now):
    try:
        st = os.lstat(filepath)
    except Exception as e:
        return None

    mode = st.st_mode
    is_dir = stat.S_ISDIR(mode)
    is_lnk = stat.S_ISLNK(mode)
    is_reg = stat.S_ISREG(mode)
    is_exec = is_reg and (mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH))

    # Permissions string + extended attributes indicator
    mode_str = stat.filemode(mode)
    if has_xattrs(filepath):
        mode_str += '@'
    else:
        mode_str += ' '

    # Owner & Group
    try:
        owner = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        owner = str(st.st_uid)
        
    try:
        group = grp.getgrgid(st.st_gid).gr_name
    except KeyError:
        group = str(st.st_gid)

    # Size (or Major, Minor for devices)
    if stat.S_ISCHR(mode) or stat.S_ISBLK(mode):
        size_str = f"{os.major(st.st_rdev):>3}, {os.minor(st.st_rdev):>3}"
    else:
        size_str = format_size(st.st_size, human=args.human_readable)

    # Date
    time_str = format_mtime(st.st_mtime, now)

    # Name styling
    if is_lnk:
        try:
            target = os.readlink(filepath)
            colored_name = f"{colorize(filename, 'link', use_color)} -> {target}"
            display_name_len = len(filename) + 4 + len(target)
        except Exception:
            colored_name = colorize(filename, 'link', use_color)
            display_name_len = len(filename)
    elif is_dir:
        colored_name = colorize(filename, 'dir', use_color)
        display_name_len = len(filename)
    elif is_exec:
        colored_name = colorize(filename, 'exec', use_color)
        display_name_len = len(filename)
    else:
        if stat.S_ISSOCK(mode):
            colored_name = colorize(filename, 'socket', use_color)
        elif stat.S_ISFIFO(mode):
            colored_name = colorize(filename, 'fifo', use_color)
        elif stat.S_ISBLK(mode) or stat.S_ISCHR(mode):
            colored_name = colorize(filename, 'device', use_color)
        else:
            colored_name = filename
        display_name_len = len(filename)

    # Comments
    comment = get_descript_ion_comment(filepath)
    if not comment:
        comment = get_finder_comment(filepath)
    if not comment and filename.lower().endswith('.zip'):
        comment = get_zip_diz_comment(filepath)
    if comment:
        comment = clean_comment(comment)

    return {
        'mode': mode_str,
        'nlink': st.st_nlink,
        'owner': owner,
        'group': group,
        'size': size_str,
        'time': time_str,
        'colored_name': colored_name,
        'display_name_len': display_name_len,
        'comment': comment,
        'st_blocks': st.st_blocks,
        'st_size': st.st_size,
        'st_mtime': st.st_mtime,
        'name': filename
    }

def list_directory(dirpath, args, use_color, now, print_header=False):
    if print_header:
        print(f"{dirpath}:")

    try:
        entries = os.listdir(dirpath)
    except Exception as e:
        print(f"lsc: {dirpath}: {e}", file=sys.stderr)
        return

    # Filter files
    files_to_list = []
    if args.all:
        files_to_list = ['.', '..'] + entries
    elif args.almost_all:
        files_to_list = entries
    else:
        files_to_list = [e for e in entries if not e.startswith('.')]

    # Get info
    infos = []
    for f in files_to_list:
        filepath = os.path.join(dirpath, f)
        info = get_file_info(filepath, f, args, use_color, now)
        if info:
            infos.append(info)

    # Sort
    if args.sort_size:
        infos.sort(key=lambda x: x['st_size'], reverse=not args.reverse)
    elif args.sort_time:
        infos.sort(key=lambda x: x['st_mtime'], reverse=not args.reverse)
    else:
        # Default alphabetical
        infos.sort(key=lambda x: x['name'].lower(), reverse=args.reverse)

    if not infos:
        return

    # Print total
    total_blocks = sum(info['st_blocks'] for info in infos)
    if args.human_readable:
        # 512 bytes per block
        print(f"total {format_size(total_blocks * 512, human=True)}")
    else:
        print(f"total {total_blocks}")

    # Format and print rows
    print_table(infos, use_color)

def print_table(infos, use_color):
    max_nlink = max(len(str(x['nlink'])) for x in infos)
    max_owner = max(len(x['owner']) for x in infos)
    max_group = max(len(x['group']) for x in infos)
    max_size = max(len(x['size']) for x in infos)
    max_name = max(x['display_name_len'] for x in infos)

    for x in infos:
        prefix = f"{x['mode']}  {x['nlink']:>{max_nlink}} {x['owner']:<{max_owner}}  {x['group']:<{max_group}}  {x['size']:>{max_size}} {x['time']}"
        
        # Pad the name correctly ignoring ANSI colors
        name_padding = " " * (max_name - x['display_name_len'])
        name_part = f"{x['colored_name']}{name_padding}"
        
        if x['comment']:
            print(f"{prefix} {name_part}   | {colorize(x['comment'], 'comment', use_color)}")
        else:
            print(f"{prefix} {name_part}")

def export_comment_for_path_itself(path):
    abs_path = os.path.abspath(path)
    parent_dir = os.path.dirname(abs_path)
    filename = os.path.basename(abs_path)
    if not filename:
        return

    finder_comment = get_finder_comment(abs_path)
    if not finder_comment:
        return

    cleaned = clean_comment(finder_comment)
    if not cleaned:
        return

    descriptions = {}
    ion_path = os.path.join(parent_dir, "descript.ion")
    if os.path.exists(ion_path):
        try:
            with open(ion_path, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    try:
                        parts = shlex.split(line)
                    except ValueError:
                        parts = line.split(maxsplit=1)
                    if len(parts) >= 2:
                        fname = parts[0].strip('"').strip("'")
                        desc = " ".join(parts[1:])
                        descriptions[fname] = desc
        except Exception:
            pass

    if descriptions.get(filename) != cleaned:
        descriptions[filename] = cleaned
        try:
            sorted_items = sorted(descriptions.items())
            with open(ion_path, "w", encoding="utf-8") as f:
                for fname, desc in sorted_items:
                    if ' ' in fname or '"' in fname or "'" in fname:
                        escaped_fname = f'"{fname}"'
                    else:
                        escaped_fname = fname
                    f.write(f"{escaped_fname} {desc}\n")
            print(f"lsc: Exported comment for '{filename}' to {ion_path}")
        except Exception as e:
            print(f"lsc: Failed to write {ion_path}: {e}", file=sys.stderr)

def export_comments_for_dir(dirpath):
    try:
        entries = os.listdir(dirpath)
    except Exception as e:
        print(f"lsc: Cannot list {dirpath} for export: {e}", file=sys.stderr)
        return

    descriptions = {}
    ion_path = os.path.join(dirpath, "descript.ion")
    if os.path.exists(ion_path):
        try:
            with open(ion_path, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    try:
                        parts = shlex.split(line)
                    except ValueError:
                        parts = line.split(maxsplit=1)
                    if len(parts) >= 2:
                        fname = parts[0].strip('"').strip("'")
                        desc = " ".join(parts[1:])
                        descriptions[fname] = desc
        except Exception:
            pass

    updated = False
    for filename in entries:
        if filename == "descript.ion" or filename in ('.', '..'):
            continue
        filepath = os.path.join(dirpath, filename)
        finder_comment = get_finder_comment(filepath)
        if finder_comment:
            cleaned = clean_comment(finder_comment)
            if cleaned and descriptions.get(filename) != cleaned:
                descriptions[filename] = cleaned
                updated = True

    if updated:
        try:
            sorted_items = sorted(descriptions.items())
            with open(ion_path, "w", encoding="utf-8") as f:
                for fname, desc in sorted_items:
                    if ' ' in fname or '"' in fname or "'" in fname:
                        escaped_fname = f'"{fname}"'
                    else:
                        escaped_fname = fname
                    f.write(f"{escaped_fname} {desc}\n")
            print(f"lsc: Exported comments for contents of '{dirpath}' to {ion_path}")
        except Exception as e:
            print(f"lsc: Failed to write {ion_path}: {e}", file=sys.stderr)

def set_comment_for_path(path, comment_text):
    abs_path = os.path.abspath(path)
    parent_dir = os.path.dirname(abs_path)
    filename = os.path.basename(abs_path)
    if not filename:
        print(f"lsc: Invalid path for comment: {path}", file=sys.stderr)
        return

    cleaned = clean_comment(comment_text)

    # 1. Update descript.ion
    descriptions = {}
    ion_path = os.path.join(parent_dir, "descript.ion")
    if os.path.exists(ion_path):
        try:
            with open(ion_path, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    try:
                        parts = shlex.split(line)
                    except ValueError:
                        parts = line.split(maxsplit=1)
                    if len(parts) >= 2:
                        fname = parts[0].strip('"').strip("'")
                        desc = " ".join(parts[1:])
                        descriptions[fname] = desc
        except Exception:
            pass

    if cleaned:
        descriptions[filename] = cleaned
    else:
        descriptions.pop(filename, None)

    try:
        if descriptions:
            sorted_items = sorted(descriptions.items())
            with open(ion_path, "w", encoding="utf-8") as f:
                for fname, desc in sorted_items:
                    if ' ' in fname or '"' in fname or "'" in fname:
                        escaped_fname = f'"{fname}"'
                    else:
                        escaped_fname = fname
                    f.write(f"{escaped_fname} {desc}\n")
            print(f"lsc: Saved comment for '{filename}' in {ion_path}")
        else:
            if os.path.exists(ion_path):
                os.remove(ion_path)
                print(f"lsc: Removed empty {ion_path}")
    except Exception as e:
        print(f"lsc: Failed to write {ion_path}: {e}", file=sys.stderr)

    # 2. Update macOS Finder comment
    if sys.platform == 'darwin':
        import subprocess
        escaped_path = abs_path.replace('\\', '\\\\').replace('"', '\\"')
        escaped_comment = cleaned.replace('\\', '\\\\').replace('"', '\\"')
        applescript_ok = False
        try:
            args = [
                'osascript',
                '-e', f'set myFile to POSIX file "{escaped_path}" as alias',
                '-e', f'tell application "Finder" to set comment of myFile to "{escaped_comment}"'
            ]
            res = subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
            if res.returncode == 0:
                applescript_ok = True
        except Exception:
            pass

        # If AppleScript fails or as fallback, write via libc to update extended attributes
        if not applescript_ok and libc:
            try:
                path_bytes = abs_path.encode('utf-8')
                name_bytes = 'com.apple.metadata:kMDItemFinderComment'.encode('utf-8')
                if cleaned:
                    # Format as binary plist list containing the comment
                    data = plistlib.dumps([cleaned], fmt=plistlib.FMT_BINARY)
                    libc.setxattr(path_bytes, name_bytes, data, len(data), 0, 0)
                else:
                    libc.removexattr(path_bytes, name_bytes, 0)
            except Exception:
                pass


def main():
    parser = argparse.ArgumentParser(description="ls-al clone with comment column support", add_help=False)
    parser.add_argument('--help', action='help', help='show this help message and exit')
    parser.add_argument('-l', action='store_true', help="long listing format (always enabled)")
    parser.add_argument('paths', nargs='*', default=['.'], help="files or directories to list")
    parser.add_argument('-a', '--all', action='store_true', help="do not ignore entries starting with .")
    parser.add_argument('-A', '--almost-all', action='store_true', help="do not list implied . and ..")
    parser.add_argument('-h', '--human-readable', action='store_true', help="print sizes in human readable format")
    parser.add_argument('-d', '--directory', action='store_true', help="list directories themselves, not their contents")
    parser.add_argument('-r', '--reverse', action='store_true', help="reverse order while sorting")
    parser.add_argument('-S', action='store_true', dest='sort_size', help="sort by file size")
    parser.add_argument('-t', action='store_true', dest='sort_time', help="sort by modification time")
    parser.add_argument('--color', choices=['always', 'never', 'auto'], default='auto', help="colorize the output")
    parser.add_argument('--export-comments', action='store_true', help="export macOS Finder comments to descript.ion files")
    parser.add_argument('--set-comment', type=str, metavar='COMMENT', help="set comment for specified files or directories")

    args = parser.parse_args()

    if args.export_comments:
        if sys.platform != 'darwin' or not libc:
            print("lsc: exporting comments is only supported on macOS with active libc access", file=sys.stderr)
            sys.exit(1)
        for path in args.paths:
            if not os.path.exists(path) and not os.path.islink(path):
                print(f"lsc: {path}: No such file or directory", file=sys.stderr)
                continue
            
            export_comment_for_path_itself(path)
            if os.path.isdir(path) and not os.path.islink(path):
                export_comments_for_dir(path)
        sys.exit(0)

    if args.set_comment is not None:
        for path in args.paths:
            if not os.path.exists(path) and not os.path.islink(path):
                print(f"lsc: {path}: No such file or directory", file=sys.stderr)
                continue
            set_comment_for_path(path, args.set_comment)
        sys.exit(0)

    # Color detection
    if args.color == 'always':
        use_color = True
    elif args.color == 'never':
        use_color = False
    else:  # auto
        use_color = sys.stdout.isatty()

    now = time.time()

    # Separate file paths and directory paths
    files = []
    dirs = []

    for path in args.paths:
        if not os.path.exists(path) and not os.path.islink(path):
            print(f"lsc: {path}: No such file or directory", file=sys.stderr)
            continue
        
        if os.path.isdir(path) and not args.directory and not os.path.islink(path):
            dirs.append(path)
        else:
            files.append(path)

    # List explicit files first
    if files:
        infos = []
        for f in files:
            info = get_file_info(f, f, args, use_color, now)
            if info:
                infos.append(info)
        
        if args.sort_size:
            infos.sort(key=lambda x: x['st_size'], reverse=not args.reverse)
        elif args.sort_time:
            infos.sort(key=lambda x: x['st_mtime'], reverse=not args.reverse)
        else:
            infos.sort(key=lambda x: x['name'].lower(), reverse=args.reverse)
            
        print_table(infos, use_color)
        if dirs:
            print() # empty line separator

    # List directories
    print_header = len(args.paths) > 1 or (len(files) > 0 and len(dirs) > 0)
    for idx, d in enumerate(dirs):
        if idx > 0:
            print()
        list_directory(d, args, use_color, now, print_header)

if __name__ == "__main__":
    main()
